# ---- Server ----
PORT=3001
# Bind host. 127.0.0.1 untuk dev lokal; docker-compose meng-override ke 0.0.0.0.
HOST=127.0.0.1
XAUUSD_SYMBOL=OANDA:XAUUSD

# ---- PostgreSQL (Prisma) ----
# Dev lokal: pakai URL langsung ini.
# Docker compose MENGABAIKAN baris ini — DATABASE_URL dirakit dari DB_* di bawah.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/tradingvapp

# ---- Docker compose (.env.production) ----
# db-setup & app merakit:
#   postgresql://$DB_USERNAME:$DB_PASSWORD@$DB_HOST:5432/$DB_DATABASE?schema=public
DB_HOST=host.docker.internal
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=tradingvapp

# Domain publik untuk label Traefik (wajib; kosong = compose gagal).
APP_DOMAIN=
